<Window x:Class="Waypoint.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize - Waypoint" Icon="pack://application:,,,/Assets/waypoint.png" Height="780" Width="1160" MinHeight="600" MinWidth="900"
        Closing="Window_Closing" AllowDrop="True" Drop="Window_Drop"
        Background="#F5F6F8" FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="30"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="28"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#202A3A" Padding="28,0"><Grid>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Waypoint" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Customize your launcher" Foreground="#C7D0DD" Margin="0,3,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Foreground="#D5DFEA" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="Save" Width="90" Margin="0,0,8,0" Click="Save_Click"/><Button Content="Save &amp; Close" Width="112" Click="SaveClose_Click"/></StackPanel>
    </Grid></Border>
    <TabControl x:Name="RootTabs" Grid.Row="1" Margin="22,18,22,22" Padding="10,6">
      <TabItem Header="Favorites"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#D8DCE3" BorderThickness="1" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Groups" FontWeight="SemiBold" FontSize="15"/><TextBox x:Name="MenuFilter" Margin="0,10,0,10" TextChanged="MenuFilter_Changed" ToolTip="Filter groups"/></StackPanel><TreeView x:Name="MenuTree" SelectedItemChanged="MenuTree_SelectedItemChanged" /></DockPanel></Border>
        <Border Grid.Column="2" Background="White" BorderBrush="#D8DCE3" BorderThickness="1" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><WrapPanel ItemHeight="30" Margin="0,0,0,8"><ComboBox x:Name="AddKind" Width="150" Margin="0,0,8,0" SelectedIndex="0"><ComboBoxItem Content="Folder"/><ComboBoxItem Content="File"/><ComboBoxItem Content="Special folder"/><ComboBoxItem Content="Shell location"/><ComboBoxItem Content="Submenu"/><ComboBoxItem Content="Separator"/></ComboBox><Button Content="Add" Margin="0,0,8,0" Click="Add_Click"/><Button Content="Import..." Margin="0,0,8,0" Click="Import_Click"/><Button Content="Special folders" Click="SpecialFolders_Click"/></WrapPanel><WrapPanel ItemHeight="30"><Button Content="Edit" Margin="0,0,8,0" Click="Edit_Click"/><Button Content="Remove" Margin="0,0,8,0" Click="Remove_Click"/><Button Content="Duplicate" Margin="0,0,8,0" Click="Duplicate_Click"/><Button Content="Copy" Margin="0,0,8,0" Click="Copy_Click"/><Button Content="Paste" Margin="0,0,16,0" Click="Paste_Click"/><Button Content="Move..." Margin="0,0,8,0" Click="MoveToMenu_Click"/><Button Content="↑" Margin="0,0,4,0" Click="Up_Click"/><Button Content="↓" Click="Down_Click"/></WrapPanel></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,14,0,10"><TextBlock Text="Favorites" FontWeight="SemiBold" FontSize="15"/><TextBox x:Name="ItemSearch" Margin="0,8,0,0" TextChanged="ItemSearch_Changed" ToolTip="Search all favorites (Ctrl+F)"/></StackPanel>
          <DataGrid x:Name="ItemsGrid" Grid.Row="2" AutoGenerateColumns="False" SelectionMode="Extended" CanUserAddRows="False" AllowDrop="True" PreviewMouseMove="ItemsGrid_PreviewMouseMove" Drop="ItemsGrid_Drop" MouseDoubleClick="ItemsGrid_DoubleClick" PreviewMouseRightButtonDown="ItemsGrid_PreviewMouseRightButtonDown" ContextMenuOpening="ItemsGrid_ContextMenuOpening"><DataGrid.ContextMenu><ContextMenu><MenuItem Header="Import subfolders..." Click="ImportSubfolders_Click"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Group" Binding="{Binding MenuName}" Width="*"/><DataGridTextColumn Header="Path / target" Binding="{Binding Target}" Width="3*"/></DataGrid.Columns></DataGrid>
        </Grid></Border>
      </Grid></TabItem>
      <TabItem Header="Quick Launch"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="760">
        <TextBlock Text="Launcher behavior" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="Choose how Waypoint opens and which sources Quick Launch searches." Foreground="#586174" Margin="0,0,0,18"/>
        <GroupBox Header="Quick Launch"><StackPanel><TextBlock Text="Quick Launch hotkey"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBox x:Name="QuickLaunchHotkey" Width="180"/><Button Content="Record" Margin="8,0,0,0" Click="RecordQuickLaunchHotkey_Click"/></StackPanel><TextBlock Text="Search sources" FontWeight="SemiBold" Margin="0,16,0,8"/><WrapPanel><CheckBox x:Name="RecentFolders" Content="Recent folders" Margin="0,0,24,10"/><CheckBox x:Name="FrequentFolders" Content="Frequent folders" Margin="0,0,24,10"/><CheckBox x:Name="OpenWindows" Content="Open windows" Margin="0,0,24,10"/><CheckBox x:Name="Bookmarks" Content="Bookmarks" Margin="0,0,24,10"/><CheckBox x:Name="BrowserHistory" Content="Browser history" Margin="0,0,24,10"/><CheckBox x:Name="Apps" Content="Apps" Margin="0,0,24,10"/><CheckBox x:Name="Everything" Content="Everything" Margin="0,0,24,10"/><CheckBox x:Name="SearchPaths" Content="Search folder paths" Margin="0,0,24,10"/></WrapPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Visible results" VerticalAlignment="Center"/><TextBox x:Name="VisibleResults" Width="64" Margin="12,0,0,0"/></StackPanel></StackPanel></GroupBox>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Variables"><DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Variables" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Use variables such as %PROJECTS% in folder and file paths." Foreground="#586174" Margin="0,6,0,16"/><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="Add variable" Click="AddVariable_Click"/><Button Content="Remove selected" Margin="8,0,0,0" Click="RemoveVariable_Click"/></StackPanel></StackPanel><DataGrid x:Name="VariablesGrid" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
      <TabItem Header="Azure DevOps"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Azure DevOps" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Choose the projects that Quick Launch searches with the az prefix." Foreground="#586174" Margin="0,6,0,12"/><StackPanel Orientation="Horizontal"><CheckBox x:Name="AzureEnabled" Content="Enable Azure DevOps search" FontWeight="SemiBold"/><Button Content="Suggest priorities from recent activity" Margin="18,0,0,0" Click="SuggestPriorities_Click"/></StackPanel><Expander Header="Connection" Margin="0,12,0,0"><StackPanel Margin="12,8,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Organization" VerticalAlignment="Center"/><TextBox x:Name="AzureConnectionOrganization" Width="180" Margin="10,0,20,0"/><TextBlock Text="PAT" VerticalAlignment="Center"/><PasswordBox x:Name="AzurePat" Width="200" Margin="10,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Save PAT and load projects" Click="SavePatAndLoad_Click"/><Button Content="Load projects" Margin="8,0,0,0" Click="LoadAzureProjects_Click"/><Button Content="Delete PAT" Margin="8,0,0,0" Click="DeletePat_Click"/><Button Content="Import watched projects..." Margin="18,0,0,0" Click="ImportAzureProjects_Click"/><Button Content="Export..." Margin="8,0,0,0" Click="ExportAzureProjects_Click"/></StackPanel><TextBlock x:Name="AzureConnectionStatus" Foreground="#586174" Margin="0,8,0,0"/></StackPanel></Expander></StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="White" BorderBrush="#D8DCE3" BorderThickness="1" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Watched projects" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Projects are searched and synchronized in priority order." Foreground="#586174" TextWrapping="Wrap" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Add project" Click="AddAzureProject_Click"/><Button Content="Remove" Margin="8,0,0,0" Click="RemoveAzureProject_Click"/></StackPanel></StackPanel><DataGrid x:Name="AzureProjectsGrid" Margin="0,14,0,0" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="AzureProjectSelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Organization" Binding="{Binding Organization}" Width="*"/><DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
          <Border Grid.Column="2" Background="White" BorderBrush="#D8DCE3" BorderThickness="1" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AzureDetailsPanel"><TextBlock Text="Project details" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Select a watched project to edit its scope." Foreground="#586174" Margin="0,4,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Organization"/><TextBox x:Name="AzureOrganization" Margin="0,4,0,12"/><TextBlock Text="Project"/><TextBox x:Name="AzureProject" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Aliases — comma separated"/><TextBox x:Name="AzureAliases" Margin="0,4,0,12"/><TextBlock Text="Priority — lower runs first"/><TextBox x:Name="AzurePriority" Margin="0,4,0,12"/></StackPanel></Grid><Separator Margin="0,8,0,16"/><TextBlock Text="Search scope" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,8"><CheckBox x:Name="AzurePullRequests" Content="Pull requests" Margin="0,0,24,8"/><CheckBox x:Name="AzurePipelines" Content="Pipelines" Margin="0,0,24,8"/><CheckBox x:Name="AzureWorkItems" Content="Work items" Margin="0,0,24,8"/></WrapPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,4"><TextBlock Text="Interest repositories" VerticalAlignment="Center"/><Button Content="Choose..." Margin="8,0,0,0" Click="LoadRepositories_Click"/></StackPanel><TextBox x:Name="AzureRepositories" IsReadOnly="True" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"/><StackPanel Orientation="Horizontal" Margin="0,12,0,4"><TextBlock Text="Interest areas" VerticalAlignment="Center"/><Button Content="Choose..." Margin="8,0,0,0" Click="LoadAreas_Click"/><Button Content="Suggest from my assigned work items" Margin="8,0,0,0" Click="SuggestAreas_Click"/></StackPanel><TextBox x:Name="AzureAreas" IsReadOnly="True" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Interest iterations — one per line" Margin="0,12,0,4"/><TextBox x:Name="AzureIterations" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"/></StackPanel></ScrollViewer></Border>
        </Grid>
      </Grid></TabItem>
    </TabControl>
  </Grid>
</Window>
