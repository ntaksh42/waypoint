<Window x:Class="Waypoint.Settings.FolderImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Waypoint.Settings"
        Title="Import folder structure" Width="700" Height="640" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type local:FolderImportNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding Included}" VerticalAlignment="Center"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="360" Margin="8,2,0,2"/></StackPanel>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Import" Width="88" Margin="0,0,8,0" Click="Import_Click"/><Button Content="Cancel" IsCancel="True" Width="88"/></StackPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="Root folder"/><Grid Margin="0,4,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RootPath"/><Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click"/></Grid><StackPanel Orientation="Horizontal"><TextBlock Text="Subfolder depth" VerticalAlignment="Center"/><ComboBox x:Name="Depth" Width="70" Margin="10,0,10,0" SelectedIndex="2"><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/></ComboBox><Button Content="Preview" Click="Preview_Click"/></StackPanel><TextBlock Text="Rename items or uncheck folders to exclude them. Import runs once; folders are not synchronized afterwards." TextWrapping="Wrap" Margin="0,12,0,12" Foreground="#586174"/></StackPanel>
    <TreeView x:Name="PreviewTree"/>
  </DockPanel>
</Window>
