{
  "manifest_version": 3,
  "name": "Waypoint Tab Bridge",
  "version": "0.2.0",
  "description": "Makes current Chrome and Edge tabs searchable from Waypoint, and lets Waypoint edit Edge bookmarks.",
  "key": "",
  "permissions": [
    "tabs",
    "bookmarks",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
